# ==============================================================================
# Backend Environment Configuration
# ==============================================================================

# Database Connection (Metadata)
# ------------------------------------------------------------------------------
# 1. Local Development (Default if empty):
# DATABASE_URL=sqlite:///local_storage/music.db

# 2. Turso (Free Lifetime Edge SQLite / LibSQL):
# Create a free database at https://turso.tech (turso db create spotify)
# DATABASE_URL=sqlite+libsql://spotify-[org].turso.io?authToken=[your-turso-token]

# 3. Supabase / Neon (Free Lifetime PostgreSQL):
# DATABASE_URL=postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres

DATABASE_URL=
TURSO_DB_URL=
TURSO_AUTH_TOKEN=

# Spotify API Credentials (Optional - app scrapes public embed metadata if omitted)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
